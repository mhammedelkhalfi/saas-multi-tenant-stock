# Template — copier vers .env : cp .env.example .env
# Le fichier .env est utilisé par l'application (gitignored).

SPRING_PROFILES_ACTIVE=dev

DB_HOST=localhost
DB_PORT=5433
DB_NAME=saas-db
DB_USERNAME=postgres
DB_PASSWORD=postgres
SERVER_PORT=8080

JWT_PRIVATE_KEY_PATH=certs/private_key.pem
JWT_PUBLIC_KEY_PATH=certs/public_key.pem
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=60

SYSTEM_ADMIN_ENABLED=true
SYSTEM_ADMIN_USERNAME=platform-admin
SYSTEM_ADMIN_PASSWORD=ChangeMe123!
SYSTEM_ADMIN_EMAIL=platform-admin@system.local
SYSTEM_ADMIN_FIRST_NAME=Platform
SYSTEM_ADMIN_LAST_NAME=Administrator
SYSTEM_TENANT_CODE=system
SYSTEM_TENANT_NAME=System Platform
SYSTEM_TENANT_EMAIL=system@platform.local
